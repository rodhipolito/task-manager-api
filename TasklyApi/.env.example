# Database Configuration
ConnectionStrings__DefaultConnection=Server=localhost;Database=TasklyDB;Trusted_Connection=true;TrustServerCertificate=true;

# JWT Configuration
JWT__Secret=your-super-secret-jwt-key-minimum-32-characters
JWT__Issuer=TasklyApi
JWT__Audience=TasklyApp

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:7000;http://localhost:5000

# CORS
AllowedOrigins=http://localhost:5173,http://localhost:3000
